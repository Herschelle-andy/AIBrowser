{
  "manifest_version": 3,
  "name": "Sahayak",
  "version": "1.0.0",
  "description": "Your browser AI assistant — reads, explains, sees, and acts with your approval.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/index.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/lib/Readability.js",
        "content/reader.js",
        "content/youtube.js",
        "content/scanner.js",
        "content/overlay.js",
        "content/executor.js",
        "content/index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {},
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}